# Kopiera till .env (gitignorerad) och fyll i. Se README.md.

# Hemlig sträng för Auth.js sessionscookie. Skapa med: npx auth secret  (eller: openssl rand -base64 33)
AUTH_SECRET=

# Google OAuth-klient (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Kommaseparerad lista över e-postadresser som får logga in. Tom = ingen släpps in.
ALLOWED_EMAILS=

# Skapas när en Blob-store (privat åtkomst) kopplas till Vercel-projektet
BLOB_READ_WRITE_TOKEN=

# Claude API (pass-byggaren och hjälparen). Sätt en månadsgräns för nyckeln i Anthropics Console.
ANTHROPIC_API_KEY=
# Modell för pass-byggaren. Tom = claude-sonnet-5-5
MODEL_BUILDER=claude-sonnet-5-5
# Modell för hjälparen under passet. Tom = claude-haiku-4-5
MODEL_HELPER=claude-haiku-4-5
