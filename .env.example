# Copy to .env (gitignored) and fill in. See README.md.

# Secret for the Auth.js session cookie. Create with: npx auth secret  (or: openssl rand -base64 33)
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Comma-separated list of e-mail addresses allowed to sign in. Empty = nobody gets in.
ALLOWED_EMAILS=

# Created when a Blob store (private access) is connected to the Vercel project
BLOB_READ_WRITE_TOKEN=

# Claude API (workout builder and in-session helper). Set a monthly limit for the key in the Anthropic Console.
ANTHROPIC_API_KEY=
# Model for the workout builder. Empty = claude-sonnet-5-5
MODEL_BUILDER=claude-sonnet-5-5
# Model for the in-session helper. Empty = claude-haiku-4-5
MODEL_HELPER=claude-haiku-4-5
# Max Claude API calls per user and day (builder and helper combined). Empty = 200, 0 = disabled.
AI_DAILY_LIMIT=
