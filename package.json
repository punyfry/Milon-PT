		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.6",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.135.0",
